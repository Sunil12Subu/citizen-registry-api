# Copy this file to .env and replace every "change-me" value.
# .env is git-ignored. NEVER commit real secrets.

APP_ENV=development

# PostgreSQL container settings (used by docker-compose.yml)
POSTGRES_USER=registry_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=registry

# Connection string used by the Python app
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+psycopg://registry_user:change-me@localhost:5432/registry

# Clients must send this key in the X-API-Key header
API_KEY=change-me

# Secret used to hash Aadhaar numbers (explained when we build security.py)
ID_HASH_SECRET=change-me