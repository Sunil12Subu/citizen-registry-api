# Store all text files in Git with LF line endings, on every OS.
# Prevents "every line changed" diffs and broken scripts in Linux/Docker.
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert
*.png binary
*.jpg binary
*.pdf binary